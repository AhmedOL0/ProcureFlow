{
  "title": "ProcureFlow - HTTP overview",
  "tags": ["procureflow"],
  "timezone": "utc",
  "panels": [
    {
      "title": "HTTP request rate (5m)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[5m])) by (uri, status)"
        }
      ]
    },
    {
      "title": "JVM heap used",
      "type": "timeseries",
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"}"
        }
      ]
    }
  ]
}
