# ============================================================
# ProcureFlow — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=procureflow
POSTGRES_USER=procureflow
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# ---- Backend datasource (used by Spring Boot directly) ----
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/procureflow
SPRING_DATASOURCE_USERNAME=procureflow
SPRING_DATASOURCE_PASSWORD=change-me

# ---- Backend auth ----
# JWT_SECRET must be >= 64 random characters — the boot refuses anything
# shorter (HS512 needs 512 bits). Generate one with:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 64 | ForEach-Object { [char]$_ })
# NOTE: `docker compose` reads this file, but `./mvnw spring-boot:run` does
# NOT — export the vars in that shell instead (see README "Local development"
# and AGENTS.md gotcha 21 for the stale-pgdata password trap).
JWT_SECRET=change-me-min-64-chars-for-hs512-signing-key-please-rotate-me
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ---- AI (Groq — backend only, never exposed to Angular) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_ENABLED=false
AI_MONTHLY_TOKEN_CAP=1000000

# ---- Mail (Brevo SMTP; see docs/security/secrets.md) ----
MAIL_PROVIDER=log
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com

# ---- Browser origin for emailed links (validated: absolute http(s) only) ----
APP_FRONTEND_URL=http://localhost:4200

# ---- Auth tuning ----
PASSWORD_RESET_TTL_MINUTES=30

# ---- Frontend ----
ANGULAR_API_URL=http://localhost:8080

# ---- MongoDB (AI extraction history; derived docs, PG authoritative) ----
MONGODB_URI=mongodb://localhost:27017/procureflow?serverSelectionTimeoutMS=2000&connectTimeoutMS=2000
MONGO_PORT=27017

# ---- Antivirus (opt-in scan profile; blank host disables with a warning) ----
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000

# ---- Observability (opt-in profile; see infrastructure/monitoring/README.md) ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100

# ---- Local ports (host side; container ports stay fixed) ----
# Set BACKEND_PORT=8081 if something already owns :8080, and point
# ANGULAR_API_URL + CORS_ALLOWED_ORIGINS at the same backend URL.
BACKEND_PORT=8080
FRONTEND_PORT=4200
CORS_ALLOWED_ORIGINS=http://localhost:4200
