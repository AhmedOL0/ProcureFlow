<?xml version="1.0" encoding="UTF-8"?>
<!-- Human-readable console logs with the request correlation id appended.
     Same shape as Spring Boot's default pattern plus trace=<mdc>; JSON
     logging stays deferred until a collector exists to consume it. -->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%5p) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(trace=%X{traceId}){faint} %clr(:){faint} %m%n%wEx</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
